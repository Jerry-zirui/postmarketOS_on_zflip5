+int tfa_get_power_state(int index)
+{
+	struct tfa_device *tfa = tfa98xx_get_tfa_device_from_index(index);
+	int pm = 0;
+	int state = 0, control = 0;
+
+	if (tfa == NULL)
+		return 0x4; /* unused device; power down */
+
+	state = TFAxx_GET_BF(tfa, LP0);
+	control = TFAxx_GET_BF(tfa, IPM);
+	if ((control == 0x0 || control == 0x3)
+		&& (state == 0x1))
+		pm |= 0x2; /* idle power */
+	switch (tfa->rev & 0xff) {
+	case 0x78:
+	case 0x74:
+	case 0x72:
+	case 0x94:
+		state = TFAxx_GET_BF(tfa, LP1);
+		control = TFAxx_GET_BF(tfa, LPM1MODE);
+		if ((control == 0x0 || control == 0x3)
+			&& (state == 0x1))
+			pm |= 0x1; /* low power */
+		break;
+	default:
+		/* neither TFA987x */
+		break;
+	}
+
+	state = TFA_GET_BF(tfa, PWDN);
+	if (state == 1)
+		pm |= 0x4; /* power down */
+
+	return pm;
+}
+EXPORT_SYMBOL(tfa_get_power_state);
