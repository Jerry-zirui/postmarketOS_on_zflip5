+	tfa98xx_cal_exit(g_tfa_class);
+
+	tfa98xx_stc_exit(g_tfa_class);
+
+	class_destroy(g_tfa_class);
+	pr_info("exited\n");
+}
+module_exit(tfa98xx_sysfs_exit);
+
+MODULE_DESCRIPTION("ASoC TFA98XX sysfs node driver");
