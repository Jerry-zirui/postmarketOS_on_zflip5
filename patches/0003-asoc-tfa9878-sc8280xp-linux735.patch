+
+			pr_info("%s: [%d] resume channel\n",
+				__func__, dev);
+			mutex_lock(&tfa98xx->dsp_lock);
+			pr_info("%s: trigger [dev %d - prof %d]\n", __func__,
+				dev, tfa98xx->profile);
