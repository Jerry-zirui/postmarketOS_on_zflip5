+static int tfa98xx_ext_reset(struct tfa98xx *tfa98xx)
+{
+	if (tfa98xx && tfa98xx->reset_gpiod) {
+		gpiod_set_value_cansleep(tfa98xx->reset_gpiod, 1);
+		msleep(TFA_RESET_DELAY);
+		gpiod_set_value_cansleep(tfa98xx->reset_gpiod, 0);
+		msleep(TFA_RESET_DELAY);
+	}
+
+	return 0;
