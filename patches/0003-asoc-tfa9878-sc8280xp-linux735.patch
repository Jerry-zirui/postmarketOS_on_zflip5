+	}
+
+	ret = tfa98xx_cal_init(g_tfa_class);
+
+	ret = tfa98xx_stc_init(g_tfa_class);
+
+	return ret;
+}
+module_init(tfa98xx_sysfs_init);
+
+static void __exit tfa98xx_sysfs_exit(void)
